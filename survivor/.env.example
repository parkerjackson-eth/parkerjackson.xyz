# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres (Supabase, Neon, Railway, or any managed Postgres).
# Supabase: use the "Connection pooling" / transaction-mode URI for the app.
DATABASE_URL="postgresql://user:password@host:5432/survivor?sslmode=require"

# Running on SQLite instead? Set the line above to the path below AND change
# `provider` to "sqlite" in prisma/schema.prisma. Single-instance only — see
# the README before choosing this.
# DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# The public URL of the deployed site. Vercel sets this automatically in
# production, so it is only needed for local dev and non-Vercel hosts.
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# First admin
# ---------------------------------------------------------------------------
# The account that signs up with this email is made site owner (super admin)
# automatically. Set it to your own email before you create your account.
SUPER_ADMIN_EMAIL="you@example.com"
